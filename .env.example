# Copie ce fichier en .env.local puis renseigne tes valeurs Supabase
# (Supabase > Project Settings > API).
# Sans ces variables, le site affiche des données d'exemple.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta-cle-anon-publique

# URL publique du site (utilisée pour le SEO)
NEXT_PUBLIC_SITE_URL=https://ton-domaine.fr
